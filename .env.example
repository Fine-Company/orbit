# Copy to .env.local and fill in. Get both values from the Neon console (Connect).
# With the Neon integration on Vercel, `vercel env pull .env.local` writes them for you.

# Pooled connection, used by the app. The host contains "-pooler".
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Neon Auth URL for this branch. `neon deploy` and `neon env pull` write it to .env.local.
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth"

# Signs session cookies. Not provided by Neon: generate your own, 32+ characters.
NEON_AUTH_COOKIE_SECRET=""

# Optional. Imports the organization's repositories when an admin opens /projects.
# Fine-grained token with read-only Metadata access to the organization.
GITHUB_ORG="Fine-Company"
GITHUB_TOKEN=""

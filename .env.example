# Copy to .env.local and fill in. Get both values from the Neon console (Connect).
# With the Neon integration on Vercel, `vercel env pull .env.local` writes them for you.

# Pooled connection, used by the app. The host contains "-pooler".
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
